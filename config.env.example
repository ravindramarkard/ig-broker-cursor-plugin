# Local fallback configuration for the IG Broker plugin.
# Copy to ~/.cursor/ig-broker/config.env and restrict it:  chmod 600 ~/.cursor/ig-broker/config.env
# Values set through Cursor's plugin variables take precedence over this file.
# Never commit this file.

IG_ENVIRONMENT=demo
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=

# Optional: pick a specific account when your login has several (spread bet / CFD).
# IG_ACCOUNT_ID=

# Trading guardrails
IG_TRADING_ENABLED=false
IG_MAX_DEAL_SIZE=1
IG_REQUIRE_STOP_LOSS=true
# IG_ALLOWED_EPICS=IX.D.FTSE.DAILY.IP,CS.D.EURUSD.TODAY.IP
