# Developer-only values for `npm run inspect` when Cursor's plugin settings screen
# is not in front of the process. Users set these in Customize → IG Broker.
# Never commit a filled-in copy of this file.

IG_ENVIRONMENT=demo
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=

# Optional: pick a specific account when your login has several (spread bet / CFD).
# IG_ACCOUNT_ID=

# Trading guardrails
IG_TRADING_ENABLED=false
IG_MAX_DEAL_SIZE=1
IG_REQUIRE_STOP_LOSS=true
# IG_ALLOWED_EPICS=IX.D.FTSE.DAILY.IP,CS.D.EURUSD.TODAY.IP
