{
  "name": "ig-broker-cursor-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Cursor Marketplace plugin that lets Cursor agents securely work with an IG trading account through the IG REST API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "IG_ENVIRONMENT=mock tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-plugin.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate && npm run smoke",
    "install-local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
