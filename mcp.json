{
  "mcpServers": {
    "ig-broker": {
      "command": "node",
      "args": ["${CURSOR_PLUGIN_ROOT}/dist/ig-broker-mcp.mjs"],
      "env": {
        "IG_API_KEY": "${env:IG_API_KEY}",
        "IG_IDENTIFIER": "${env:IG_IDENTIFIER}",
        "IG_PASSWORD": "${env:IG_PASSWORD}",
        "IG_ENVIRONMENT": "${env:IG_ENVIRONMENT}",
        "IG_ACCOUNT_ID": "${env:IG_ACCOUNT_ID}",
        "IG_TRADING_ENABLED": "${env:IG_TRADING_ENABLED}",
        "IG_MAX_DEAL_SIZE": "${env:IG_MAX_DEAL_SIZE}",
        "IG_REQUIRE_STOP_LOSS": "${env:IG_REQUIRE_STOP_LOSS}",
        "IG_ALLOWED_EPICS": "${env:IG_ALLOWED_EPICS}"
      }
    }
  }
}
